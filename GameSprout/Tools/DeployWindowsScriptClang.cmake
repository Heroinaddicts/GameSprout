cmake_minimum_required(VERSION 3.21)

if(CLANG_TARGET_ARCH STREQUAL "arm64")
    set(archive_arch aarch64)
    set(archive_hash 9957fee5aeba5f88369c37e127a07034eaa806c2e9e996b14ce5a32a9320653f)
else()
    set(archive_arch x86_64)
    set(archive_hash 3b568b5be1443d1a04c63261fa3a7aed16e126a8ed2196a1032aa8ed602144bd)
endif()
string(REGEX MATCH "^[0-9]+" clang_major "${CLANG_VERSION}")
get_filename_component(CLANG_DESTINATION "${CLANG_DESTINATION}" ABSOLUTE)

file(MAKE_DIRECTORY "${CLANG_CACHE_DIR}")
file(LOCK "${CLANG_CACHE_DIR}/deploy.lock" GUARD PROCESS TIMEOUT 300)

if(NOT CLANG_PACKAGE_ROOT)
    set(CLANG_PACKAGE_ROOT "${CLANG_CACHE_DIR}/${CLANG_VERSION}-${archive_arch}")
    if(NOT EXISTS "${CLANG_PACKAGE_ROOT}/bin/clang.exe" OR
       NOT EXISTS "${CLANG_PACKAGE_ROOT}/lib/clang/${clang_major}/include/stddef.h")
        set(prepared_directory "${CLANG_PACKAGE_ROOT}")
        set(archive_name "clang+llvm-${CLANG_VERSION}-${archive_arch}-pc-windows-msvc.tar.xz")
        set(archive "${CLANG_CACHE_DIR}/${archive_name}")
        if(NOT EXISTS "${archive}")
            set(url "https://github.com/llvm/llvm-project/releases/download/llvmorg-${CLANG_VERSION}/${archive_name}")
            message(STATUS "Downloading LLVM ${CLANG_VERSION} for the Editor")
            file(DOWNLOAD "${url}" "${archive}.download" EXPECTED_HASH "SHA256=${archive_hash}"
                TLS_VERIFY ON TIMEOUT 300 INACTIVITY_TIMEOUT 45)
            file(RENAME "${archive}.download" "${archive}")
        endif()
        file(SHA256 "${archive}" actual_hash)
        if(NOT actual_hash STREQUAL archive_hash)
            message(FATAL_ERROR "LLVM archive checksum mismatch: ${archive}")
        endif()

        set(unpack_directory "${CLANG_CACHE_DIR}/${archive_arch}-${archive_hash}")
        file(MAKE_DIRECTORY "${unpack_directory}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
            OUTPUT_VARIABLE archive_listing COMMAND_ERROR_IS_FATAL ANY)
        string(REPLACE "\n" ";" archive_entries "${archive_listing}")
        set(clang_entries "")
        foreach(entry IN LISTS archive_entries)
            if(entry MATCHES "(^|/)bin/(clang\\.exe|[^/]+\\.dll)$" OR
               entry MATCHES "(^|/)lib/clang/${clang_major}/include/.+[^/]$" OR
               entry MATCHES "(^|/)(LICENSE|NOTICE)[^/]*$")
                list(APPEND clang_entries "${entry}")
            endif()
        endforeach()
        if(NOT clang_entries)
            message(FATAL_ERROR "LLVM archive contains no script reflection tools: ${archive}")
        endif()
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${unpack_directory}" PATTERNS ${clang_entries})
        file(GLOB_RECURSE drivers LIST_DIRECTORIES false "${unpack_directory}/clang.exe")
        list(LENGTH drivers driver_count)
        if(NOT driver_count EQUAL 1)
            message(FATAL_ERROR "Cannot locate bin/clang.exe in the LLVM archive: ${archive}")
        endif()
        list(GET drivers 0 driver)
        get_filename_component(CLANG_PACKAGE_ROOT "${driver}/../.." ABSOLUTE)
    endif()
endif()

set(driver "${CLANG_PACKAGE_ROOT}/bin/clang.exe")
set(headers "${CLANG_PACKAGE_ROOT}/lib/clang/${clang_major}/include")
file(GLOB notices "${CLANG_PACKAGE_ROOT}/LICENSE*" "${CLANG_PACKAGE_ROOT}/NOTICE*")
if(NOT EXISTS "${driver}" OR NOT EXISTS "${headers}/stddef.h" OR NOT notices)
    message(FATAL_ERROR "Incomplete LLVM ${CLANG_VERSION} package: ${CLANG_PACKAGE_ROOT}")
endif()
string(TOLOWER "${CLANG_HOST_ARCH}" host_arch)
if((archive_arch STREQUAL "x86_64" AND host_arch MATCHES "^(amd64|x86_64|x64)$") OR
   (archive_arch STREQUAL "aarch64" AND host_arch MATCHES "^(arm64|aarch64)$"))
    execute_process(COMMAND "${driver}" --no-default-config --version
        RESULT_VARIABLE version_status OUTPUT_VARIABLE version_text ERROR_VARIABLE version_error TIMEOUT 15)
    string(REPLACE "." "\\." expected_version "${CLANG_VERSION}")
    if(NOT version_status EQUAL 0 OR NOT version_text MATCHES "clang version ${expected_version}([ \r\n]|$)")
        message(FATAL_ERROR "Expected Clang ${CLANG_VERSION} at ${driver}: ${version_text}${version_error}")
    endif()
endif()

file(GLOB runtime_dlls LIST_DIRECTORIES false "${CLANG_PACKAGE_ROOT}/bin/*.dll")
foreach(destination IN ITEMS ${prepared_directory} "${CLANG_DESTINATION}")
    file(COPY "${driver}" ${runtime_dlls} DESTINATION "${destination}/bin")
    file(COPY "${headers}" DESTINATION "${destination}/lib/clang/${clang_major}")
    file(COPY ${notices} DESTINATION "${destination}")
endforeach()
