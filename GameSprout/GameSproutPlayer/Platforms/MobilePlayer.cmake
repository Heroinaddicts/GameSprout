# Called by a mobile platform project after its SDK has selected the target ABI.
get_filename_component(gamesprout_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT EXISTS "${GAMESPROUT_SDL_SOURCE}/CMakeLists.txt")
    message(FATAL_ERROR "Set GAMESPROUT_SDL_SOURCE to the SDL source tree with the GRHI adapter extension")
endif()
set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
set(SDL_ANDROID_JAR OFF CACHE BOOL "" FORCE)
set(SDL_VULKAN ON CACHE BOOL "" FORCE)
set(SDL_OPENGLES OFF CACHE BOOL "" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
# ArkTS loads libSDL3.so directly. Versioned library names would allow it and
# the ELF linker to open two SDL instances in the same process.
set(CMAKE_PLATFORM_NO_VERSIONED_SONAME TRUE)

add_subdirectory("${GAMESPROUT_SDL_SOURCE}" "${CMAKE_CURRENT_BINARY_DIR}/SDL")
set(GAMESPROUT_GRHI_STATIC ON CACHE BOOL "" FORCE)
set(GAMESPROUT_GRHI_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/Engine" CACHE PATH "" FORCE)
set(GAMESPROUT_RUNTIME_STATIC ON CACHE BOOL "" FORCE)
set(GAMESPROUT_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/Engine" CACHE PATH "" FORCE)
add_subdirectory("${gamesprout_root}/GRHI" "${CMAKE_CURRENT_BINARY_DIR}/GRHI")
add_subdirectory("${gamesprout_root}/GameSproutRuntime" "${CMAKE_CURRENT_BINARY_DIR}/Runtime")
add_subdirectory("${gamesprout_root}/GameSproutPlayer" "${CMAKE_CURRENT_BINARY_DIR}/Player")
if(GAMESPROUT_GAMELOGIC_SOURCE)
    set(GAMESPROUT_RUNTIME_SDK_DIR "${gamesprout_root}/GameSproutRuntime/Api")
    add_subdirectory("${GAMESPROUT_GAMELOGIC_SOURCE}" "${CMAKE_CURRENT_BINARY_DIR}/GameLogic")
endif()

if(GAMESPROUT_MOBILE_NATIVE_OUTPUT)
    set_target_properties(GameSproutPlayer SDL3-shared PROPERTIES LIBRARY_OUTPUT_DIRECTORY "${GAMESPROUT_MOBILE_NATIVE_OUTPUT}")
    if(TARGET GameLogic)
        set_target_properties(GameLogic PROPERTIES LIBRARY_OUTPUT_DIRECTORY "${GAMESPROUT_MOBILE_NATIVE_OUTPUT}")
    endif()
endif()
